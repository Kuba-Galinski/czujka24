---
/**
 * Oś terminów z rozporządzenia MSWiA z 21 listopada 2024 r. (Dz.U. 2024 poz. 1716).
 * To prawdziwa sekwencja dat, więc ma formę osi czasu. Licznik dni liczy przeglądarka.
 */
const terminy = [
  {
    data: '2024-12-23',
    etykieta: '23 grudnia 2024',
    kogo: 'Nowe mieszkania i domy',
    opis: 'Lokale oddawane do użytku po tej dacie muszą mieć czujkę dymu, a w pomieszczeniach, w których spala się paliwo – także czujkę czadu.',
  },
  {
    data: '2026-06-30',
    etykieta: '30 czerwca 2026',
    kogo: 'Hotele, pensjonaty, najem krótkoterminowy',
    opis: 'Termin dla istniejących pokoi i mieszkań, w których świadczy się usługi hotelarskie.',
  },
  {
    data: '2030-01-01',
    etykieta: '1 stycznia 2030',
    kogo: 'Wszystkie pozostałe mieszkania i domy',
    opis: 'Czujka dymu w każdym lokalu mieszkalnym. Czujka czadu wszędzie tam, gdzie pracuje kocioł, piecyk gazowy, kominek albo piec.',
  },
];
---

<ol class="terminy" data-terminy>
  {
    terminy.map((t) => (
      <li data-termin={t.data}>
        <p class="terminy__data">
          <time datetime={t.data}>{t.etykieta}</time>
        </p>
        <p class="terminy__stan" data-stan />
        <h3>{t.kogo}</h3>
        <p>{t.opis}</p>
      </li>
    ))
  }
</ol>

<script>
  const odmiana = (n: number) => (n === 1 ? 'dzień' : 'dni');

  document.querySelectorAll<HTMLElement>('[data-terminy] [data-termin]').forEach((pozycja) => {
    const stan = pozycja.querySelector<HTMLElement>('[data-stan]');
    if (!stan) return;
    const termin = new Date(`${pozycja.dataset.termin}T00:00:00`);
    const dni = Math.ceil((termin.getTime() - Date.now()) / 86_400_000);

    if (dni > 0) {
      stan.textContent = `zostało ${dni.toLocaleString('pl-PL')} ${odmiana(dni)}`;
      pozycja.dataset.przyszly = 'true';
    } else {
      stan.textContent = 'już obowiązuje';
    }
  });
</script>

<style>
  .terminy {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0;
  }

  .terminy li {
    position: relative;
    padding: 0 0 var(--o-4) 2.25rem;
    border-left: 2px solid var(--tusz);
    margin-left: 0.5rem;
  }

  .terminy li:last-child {
    padding-bottom: 0;
    border-left-color: transparent;
  }

  /* punkt na osi – krążek czujki */
  .terminy li::before {
    content: '';
    position: absolute;
    left: -0.6875rem;
    top: 0.1rem;
    width: 1.25rem;
    height: 1.25rem;
    border-radius: 50%;
    background: var(--tusz);
    border: 2px solid var(--tusz);
  }

  .terminy li[data-przyszly='true']::before {
    background: var(--papier);
    border-color: var(--czerwien);
    box-shadow: inset 0 0 0 4px var(--papier), inset 0 0 0 10px var(--czerwien);
  }

  .terminy__data {
    font-family: var(--kroj-waski);
    font-weight: 800;
    font-size: var(--t-xl);
    line-height: 1;
  }

  .terminy__stan {
    min-height: 1.5em;
    margin-top: 0.3rem;
    font-size: var(--t-xs);
    font-weight: 700;
    color: var(--tusz-2);
  }

  .terminy li[data-przyszly='true'] .terminy__stan {
    color: var(--czerwien-ciemna);
  }

  .terminy h3 {
    margin-top: 0.6rem;
    font-size: var(--t-l);
  }

  .terminy h3 + p {
    margin-top: 0.4rem;
    max-width: 34rem;
    color: var(--tusz-2);
  }

  @media (min-width: 56rem) {
    .terminy {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .terminy li {
      padding: 2.25rem 2rem 0 0;
      margin-left: 0;
      border-left: 0;
      border-top: 2px solid var(--tusz);
    }

    .terminy li:last-child {
      border-top-color: var(--tusz);
      padding-right: 0;
    }

    .terminy li::before {
      left: 0;
      top: -0.6875rem;
    }
  }
</style>

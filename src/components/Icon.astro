---
/** Mały zestaw ikon liniowych (24 px, kreska 2). Ikony są dekoracją – podpis zawsze stoi obok. */
interface Props {
  nazwa: 'telefon' | 'email' | 'czat' | 'menu' | 'zamknij' | 'kalkulator' | 'pinezka';
  rozmiar?: number;
}
const { nazwa, rozmiar = 22 } = Astro.props;

const sciezki: Record<Props['nazwa'], string> = {
  telefon:
    '<path d="M5 3h3.2l1.6 4.4-2.1 1.5a12 12 0 0 0 7.4 7.4l1.5-2.1L21 15.8V19a2 2 0 0 1-2.2 2A17 17 0 0 1 3 5.2 2 2 0 0 1 5 3Z"/>',
  email: '<rect x="3" y="5" width="18" height="14" rx="1.5"/><path d="m3.5 6.5 8.5 6.5 8.5-6.5"/>',
  czat: '<path d="M4 5h16v11H10l-5 4v-4H4Z"/>',
  menu: '<path d="M3 6h18M3 12h18M3 18h18"/>',
  zamknij: '<path d="M5 5l14 14M19 5 5 19"/>',
  kalkulator:
    '<rect x="5" y="3" width="14" height="18" rx="1.5"/><path d="M8.5 7.5h7M8.5 12h.01M12 12h.01M15.5 12h.01M8.5 16h.01M12 16h.01M15.5 16h.01"/>',
  pinezka: '<path d="M12 21s7-6.2 7-11.5A7 7 0 0 0 5 9.500C5 14.800 12 21 12 21Z"/><circle cx="12" cy="9.500" r="2.500"/>',
};
---

<svg
  width={rozmiar}
  height={rozmiar}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={sciezki[nazwa]}
/>

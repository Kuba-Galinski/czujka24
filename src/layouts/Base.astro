---
import '@fontsource-variable/sofia-sans/wght.css';
import '@fontsource-variable/sofia-sans-condensed/wght.css';
import '../styles/global.css';

import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import TagGoogle from '../components/TagGoogle.astro';
import Zgoda from '../components/Zgoda.astro';
import { existsSync } from 'node:fs';
import { adres, firma } from '../config';
import { graf, jakoJson, type Wezel } from '../seo';

interface Props {
  tytul: string;
  opis: string;
  /** false = strona poza wyszukiwarkami (np. strona błędu). */
  indeksuj?: boolean;
  /** Dodatkowe dane strukturalne tej podstrony – patrz src/seo.ts. */
  schema?: Wezel[];
}

const { tytul, opis, indeksuj = true, schema = [] } = Astro.props;
const pelnyTytul = `${tytul} | ${firma.marka}`;
const kanoniczny = new URL(Astro.url.pathname, Astro.site);
const widoczna = indeksuj && !firma.wersjaRobocza;
// Obrazek do udostępnień pojawia się w nagłówku dopiero, gdy plik public/og.png istnieje.
const obrazOg = existsSync('public/og.png') ? new URL(adres('og.png'), Astro.site) : null;
const obrazOgOpis = `${firma.marka} – czujki dymu i czadu z montażem, szkolenia przeciwpożarowe`;
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pelnyTytul}</title>
    <meta name="description" content={opis} />
    {widoczna && <link rel="canonical" href={kanoniczny} />}
    <meta
      name="robots"
      content={widoczna ? 'index, follow, max-image-preview:large, max-snippet:-1' : 'noindex, nofollow'}
    />
    {firma.weryfikacjaGoogle && <meta name="google-site-verification" content={firma.weryfikacjaGoogle} />}
    <link rel="icon" type="image/svg+xml" href={adres('favicon.svg')} />
    <meta name="theme-color" content="#14304e" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:site_name" content={firma.marka} />
    <meta property="og:title" content={pelnyTytul} />
    <meta property="og:description" content={opis} />
    <meta property="og:url" content={kanoniczny} />
    {
      obrazOg && (
        <>
          <meta property="og:image" content={obrazOg} />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta property="og:image:alt" content={obrazOgOpis} />
        </>
      )
    }
    <meta name="twitter:card" content={obrazOg ? 'summary_large_image' : 'summary'} />

    {widoczna && <script is:inline type="application/ld+json" set:html={jakoJson(graf(Astro.site, schema))} />}

    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <TagGoogle />
  </head>
  <body>
    <a class="pomin" href="#tresc">Przejdź do treści</a>
    {
      firma.wersjaRobocza && (
        <p class="robocza">
          Wersja robocza strony – treści czekają na ostatnie sprawdzenie.
        </p>
      )
    }
    <Header />
    <main id="tresc">
      <slot />
    </main>
    <Footer />
    <Zgoda />
  </body>
</html>

<style>
  .robocza {
    margin: 0;
    padding: 0.5rem var(--margines);
    background: #fff3c4;
    color: #3d3200;
    font-size: var(--t-xs);
    font-weight: 600;
    text-align: center;
  }
</style>
